# openai: OpenAI Chat Completions 或兼容 API
# anthropic: Anthropic Messages 或兼容 API
AI_PROVIDER=openai
AI_MODEL=your-model-name
AI_API_KEY=your-api-key

# 留空时使用所选 Provider 的官方默认地址。
# OpenAI-compatible 示例：https://example.com/v1
# Anthropic-compatible 示例：https://example.com
AI_BASE_URL=

AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=800

# 可选；留空时使用内置中文助手指令。
AI_INSTRUCTIONS=
